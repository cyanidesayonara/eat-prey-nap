; Engine configuration file.
config_version=5

[application]

config/name="Eat Prey Nap"
config/description="A game for cats."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=0
boot_splash/show_image=false
boot_splash/bg_color=Color(0.914, 0.851, 0.627, 1)
config/icon="res://icon.png"

[autoload]

Sfx="*res://src/audio/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/vsync/vsync_mode=1
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.914, 0.851, 0.627, 1)
